# ローカル開発専用（docs/07-local-dev.md）。
# 本番は frontend/Dockerfile（standalone、後の Step で作成）を使う。
#
# 依存はイメージに焼き込まず、コンテナ起動時に npm install する:
#   - node_modules は compose 側で名前付きボリュームにして、ホストの OS 差を持ち込まない
#   - package-lock.json をマウントで見えるようにしておけば `npm ci` 相当の再現性が出る
FROM node:22-alpine

WORKDIR /app

# 起動: 依存を入れてから next dev。ソースは compose のバインドマウントで入る
CMD ["sh", "-c", "npm install && npm run dev"]
